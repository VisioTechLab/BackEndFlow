{
	"info": {
		"_postman_id": "leyisa-jour1-auth-collection",
		"name": "Leyisa School Jour1 Auth",
		"description": "Tests authentification JWT — Module Jour 1 LEYISA SCHOOL\n\nIMPORTANT :\n1. Importer aussi l'environnement Leyisa_School_Local.postman_environment.json\n2. Selectionner l'environnement en haut a droite\n3. Lancer Login Admin AVANT GET /api/me",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://127.0.0.1:8000" },
		{ "key": "token", "value": "" },
		{ "key": "password", "value": "password123" }
	],
	"item": [
		{
			"name": "Login Admin",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200', function () { pm.response.to.have.status(200); });",
							"const data = pm.response.json();",
							"pm.test('Token present', function () { pm.expect(data.token).to.be.a('string').and.not.empty; });",
							"if (data.token) {",
							"    pm.environment.set('token', data.token);",
							"    pm.collectionVariables.set('token', data.token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{password}}\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{base_url}}/api/login",
					"host": ["{{base_url}}"],
					"path": ["api", "login"]
				}
			}
		},
		{
			"name": "Login Direction",
			"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { const t = pm.response.json().token; pm.environment.set('token', t); pm.collectionVariables.set('token', t); }"], "type": "text/javascript" } }],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n  \"email\": \"{{direction_email}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
				"url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
			}
		},
		{
			"name": "Login Enseignant",
			"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { const t = pm.response.json().token; pm.environment.set('token', t); pm.collectionVariables.set('token', t); }"], "type": "text/javascript" } }],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n  \"email\": \"{{enseignant_email}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
				"url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
			}
		},
		{
			"name": "Login Parent",
			"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { const t = pm.response.json().token; pm.environment.set('token', t); pm.collectionVariables.set('token', t); }"], "type": "text/javascript" } }],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n  \"email\": \"{{parent_email}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
				"url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
			}
		},
		{
			"name": "Login Eleve",
			"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { const t = pm.response.json().token; pm.environment.set('token', t); pm.collectionVariables.set('token', t); }"], "type": "text/javascript" } }],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n  \"email\": \"{{eleve_email}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
				"url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
			}
		},
		{
			"name": "Login Comptable",
			"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { const t = pm.response.json().token; pm.environment.set('token', t); pm.collectionVariables.set('token', t); }"], "type": "text/javascript" } }],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n  \"email\": \"{{comptable_email}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
				"url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
			}
		},
		{
			"name": "Login Surveillant",
			"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { const t = pm.response.json().token; pm.environment.set('token', t); pm.collectionVariables.set('token', t); }"], "type": "text/javascript" } }],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n  \"email\": \"{{surveillant_email}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
				"url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
			}
		},
		{
			"name": "GET /api/me",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200', function () { pm.response.to.have.status(200); });",
							"pm.test('No password in response', function () {",
							"    pm.expect(pm.response.text()).to.not.include('password_hash');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
				"url": { "raw": "{{base_url}}/api/me", "host": ["{{base_url}}"], "path": ["api", "me"] }
			}
		},
		{
			"name": "Test mauvais mot de passe",
			"event": [{ "listen": "test", "script": { "exec": ["pm.test('Refuse 401', function () { pm.expect(pm.response.code).to.eql(401); });"], "type": "text/javascript" } }],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"wrong_password\"\n}", "options": { "raw": { "language": "json" } } },
				"url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
			}
		},
		{
			"name": "Test email inexistant",
			"event": [{ "listen": "test", "script": { "exec": ["pm.test('Refuse 401', function () { pm.expect(pm.response.code).to.eql(401); });"], "type": "text/javascript" } }],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n  \"email\": \"inexistant@leyisa.test\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
				"url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
			}
		},
		{
			"name": "Test /api/me sans token",
			"event": [{ "listen": "test", "script": { "exec": ["pm.test('Refuse 401', function () { pm.expect(pm.response.code).to.eql(401); });"], "type": "text/javascript" } }],
			"request": {
				"method": "GET",
				"url": { "raw": "{{base_url}}/api/me", "host": ["{{base_url}}"], "path": ["api", "me"] }
			}
		},
		{
			"name": "Test /api/me token invalide",
			"event": [{ "listen": "test", "script": { "exec": ["pm.test('Refuse 401', function () { pm.expect(pm.response.code).to.eql(401); });"], "type": "text/javascript" } }],
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer token_invalide_123" }],
				"url": { "raw": "{{base_url}}/api/me", "host": ["{{base_url}}"], "path": ["api", "me"] }
			}
		}
	]
}
