{
	"info": {
		"_postman_id": "leyisa-jour1-auth-collection",
		"name": "Leyisa School Jour1 Auth",
		"description": "Tests authentification JWT — Module Jour 1 LEYISA SCHOOL",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Login Admin",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    const data = pm.response.json();",
							"    if (data.token) {",
							"        pm.environment.set('token', data.token);",
							"    }",
							"}",
							"pm.test('Status 200', function () { pm.response.to.have.status(200); });",
							"pm.test('Token present', function () { pm.expect(pm.response.json().token).to.be.a('string'); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{password}}\"\n}"
				},
				"url": "{{base_url}}/api/login"
			}
		},
		{
			"name": "Login Direction",
			"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { pm.environment.set('token', pm.response.json().token); }"], "type": "text/javascript" } }],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n  \"email\": \"{{direction_email}}\",\n  \"password\": \"{{password}}\"\n}" },
				"url": "{{base_url}}/api/login"
			}
		},
		{
			"name": "Login Enseignant",
			"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { pm.environment.set('token', pm.response.json().token); }"], "type": "text/javascript" } }],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n  \"email\": \"{{enseignant_email}}\",\n  \"password\": \"{{password}}\"\n}" },
				"url": "{{base_url}}/api/login"
			}
		},
