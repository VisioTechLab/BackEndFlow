# Exemple de configuration locale (copier vers .env.local)

###> MySQL XAMPP ###
# DATABASE_URL="mysql://root:VOTRE_MOT_DE_PASSE@127.0.0.1:3306/leyisa_mvp?serverVersion=8.0.36&charset=utf8mb4"

###> SQLite (tests rapides sans MySQL) ###
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_dev.db?charset=utf8"

###> JWT dev (HS256 si pas de fichiers PEM) ###
# JWT_SECRET_KEY=ChangeThisSecretKeyForLocalDevelopmentOnly1234567890
# JWT_PUBLIC_KEY=ChangeThisSecretKeyForLocalDevelopmentOnly1234567890
# JWT_PASSPHRASE=

###> JWT dev (RSA — apres php bin/generate-jwt-keys.php) ###
# JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
# JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# JWT_PASSPHRASE=votre_passphrase
